# =================================================================
# OmniDownloader PRO - Environment Configuration Example
# =================================================================

# Server Port (Railway automatically sets $PORT in cloud)
PORT=8000
HOST=0.0.0.0

# Storage folder for downloaded media files
DOWNLOADS_DIR=downloads

# Automatic Cleanup Retention (Cloud Storage Protection)
# Automatically deletes downloaded files older than this duration (in minutes)
MAX_FILE_AGE_MINUTES=60

# How frequently the background cleanup scan runs (in minutes)
CLEANUP_INTERVAL_MINUTES=15

# Default Audio Extraction Bitrate (320, 256, 192, 128)
DEFAULT_AUDIO_BITRATE=320

# Auto-detect and download clean streams without watermarks by default
AUTO_REMOVE_WATERMARK=true

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Allowed CORS Origins (comma-separated or * for all)
CORS_ORIGINS=*
